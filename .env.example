# Copy this file to .env.local and fill in the values.
# Supabase dashboard → Project Settings → API Keys.
# The legacy "anon" key also works as the publishable key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Angel One SmartAPI live prices (Stage 6). Optional: leave blank to enter prices by hand.
# Server-only. Never add NEXT_PUBLIC_ to these names.
# API key: smartapi.angelone.in → My Apps. Client code and PIN: the ones used to log in to Angel One.
# TOTP secret: the text code shown under the QR code when enabling TOTP (not the 6-digit code).
ANGELONE_API_KEY=
ANGELONE_CLIENT_CODE=
ANGELONE_PIN=
ANGELONE_TOTP_SECRET=

# Scheduled jobs (Stage 7). Server-only; needed on Vercel, optional locally.
# Supabase dashboard → Project Settings → API Keys → Secret keys.
# It bypasses row level security: never share it or add NEXT_PUBLIC_ to the name.
SUPABASE_SECRET_KEY=
# A random string of 32+ characters. Vercel sends it to the cron routes.
CRON_SECRET=
